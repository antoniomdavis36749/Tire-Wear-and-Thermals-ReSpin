// ReSpin GT3 spectrum band - Hard Slick (C2). Requires scintilla_gt3 for meshes. Softness set for remapSlickSoftness -> hard_slick.
{
    "tire_R_325_660_18_gt3_Respin_hard_slick": {
        "information":{
            "authors":"yborella / ReSpin spectrum band",
            "name":"325/660R18 Corsa S GT3 Rear Tires Respin Hard Slick (C2)",
            "value":390,
        },
        "slotType" : "tire_R_18x12",
        "flexbodies": [
            ["mesh", "[group]:", "nonFlexMaterials"],
            ["tire_01_gt3_325_660_18_12", ["wheel_RR","tire_RR"], [], {"pos":{"x":-0.47, "y":-0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1, "y":1, "z":1}}],
            ["tire_01_gt3_325_660_18_12", ["wheel_RL","tire_RL"], [], {"pos":{"x": 0.47, "y":-0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":0},   "scale":{"x":1, "y":1, "z":1}}],
        ],
        "variables": [
            ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
            ["$tirepressure_R", "range", "psi", "Wheels", 28.0, 0, 50, "Tire Pressure", "Relative to atmospheric pressure", {"subCategory":"Rear"}],
        ],
        "pressureWheels": [
            ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
            {"disableMeshBreaking":false,"disableHubMeshBreaking":false},
            {"hasTire":true},
            {"enableTireReinfBeams":false},
            {"enableTireLbeams":true},
            {"enableTireSideReinfBeams":false},
            {"enableTreadReinfBeams":true},
            {"enableTirePeripheryReinfBeams":true},

            //general settings
            {"radius":0.330},
            {"tireWidth":0.295},

            //tire options (author carcass)
            {"wheelSideBeamSpring":"$=$tirepressure_R*300","wheelSideBeamDamp":40},
            {"wheelSideBeamSpringExpansion":701000,"wheelSideBeamDampExpansion":50},
            {"wheelSideTransitionZone":0.12,"wheelSideBeamPrecompression":0.97},

            {"wheelReinfBeamSpring":55000,"wheelReinfBeamDamp":220},
            {"wheelReinfBeamDampCutoffHz":300,"wheelReinfBeamPrecompression":0.98},

            {"wheelTreadBeamSpring":221000,"wheelTreadBeamDamp":100},
            {"wheelTreadBeamDampCutoffHz":250,"wheelTreadBeamPrecompression":0.98},

            {"wheelTreadReinfBeamSpring":201000,"wheelTreadReinfBeamDamp":100},
            {"wheelTreadReinfBeamDampCutoffHz":250,"wheelTreadReinfBeamPrecompression":0.98},

            {"wheelPeripheryBeamSpring":101000,"wheelPeripheryBeamDamp":60},
            {"wheelPeripheryBeamDampCutoffHz":250,"wheelPeripheryBeamPrecompression":0.98},

            {"wheelPeripheryReinfBeamSpring":101000,"wheelPeripheryReinfBeamDamp":60},
            {"wheelPeripheryReinfBeamDampCutoffHz":250,"wheelPeripheryReinfBeamPrecompression":0.98},

            //general tire values
            {"nodeWeight":0.20},
            {"nodeMaterial":"|NM_RUBBER"},
            {"triangleCollision":false},
            {"pressurePSI":"$tirepressure_R"},
            {"dragCoef":5},

            // ReSpin band: soft=0.50 -> hard_slick
            {"frictionCoef":1.0},
            {"slidingFrictionCoef":1.0},
            {"stribeckExponent":1.75},
            {"stribeckVelMult":2.5},
            {"treadCoef":0.0},

            {"noLoadCoef":1.85},
            {"loadSensitivitySlope":0.00022},
            {"fullLoadCoef":0.80},
            {"softnessCoef":0.50},

            //deform values
            {"wheelSideBeamDeform":17000,"wheelSideBeamStrength":22000},
            {"wheelTreadBeamDeform":12000,"wheelTreadBeamStrength":16000},
            {"wheelPeripheryBeamDeform":55000,"wheelPeripheryBeamStrength":55000},
        ],
    },
