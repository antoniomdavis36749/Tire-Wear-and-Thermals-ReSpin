        ["tire_01f_17x9_24", ["wheel_RR","tire_RR"], [], {"pos":{"x":-0.4875, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1.34, "y":1.15, "z":1.15}}],
        ["tire_01f_17x9_24", ["wheel_RL","tire_RL"], [], {"pos":{"x": 0.4875, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":0},   "scale":{"x":1.34, "y":1.15, "z":1.15}}],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$tirepressure_R", "range", "psi", "Wheels", 28, 0, 50, "Tire Pressure", "Relative to atmospheric pressure", {"subCategory":"Rear"}],
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        {"disableMeshBreaking":false,"disableHubMeshBreaking":false},
        {"hasTire":true},
        {"enableTireReinfBeams":false},
        {"enableTireLbeams":true},
        {"enableTireSideReinfBeams":false},
        {"enableTreadReinfBeams":true},
        {"enableTirePeripheryReinfBeams":true},

        //general settings
        {"radius":0.35},
        {"tireWidth":0.305},

        //tire options
        {"wheelSideBeamSpring":"$=$tirepressure_R*400","wheelSideBeamDamp":30},
        {"wheelSideBeamSpringExpansion":451000,"wheelSideBeamDampExpansion":50},
        {"wheelSideTransitionZone":0.12,"wheelSideBeamPrecompression":0.97},

        {"wheelReinfBeamSpring":55000,"wheelReinfBeamDamp":240},
        {"wheelReinfBeamDampCutoffHz":300,"wheelReinfBeamPrecompression":0.98},

        {"wheelTreadBeamSpring":241000,"wheelTreadBeamDamp":120},
        {"wheelTreadBeamDampCutoffHz":250,"wheelTreadBeamPrecompression":0.98},

        {"wheelTreadReinfBeamSpring":221000,"wheelTreadReinfBeamDamp":150},
        {"wheelTreadReinfBeamDampCutoffHz":250,"wheelTreadReinfBeamPrecompression":0.98},

        {"wheelPeripheryBeamSpring":71000,"wheelPeripheryBeamDamp":85},
        {"wheelPeripheryBeamDampCutoffHz":250,"wheelPeripheryBeamPrecompression":0.98},

        {"wheelPeripheryReinfBeamSpring":71000,"wheelPeripheryReinfBeamDamp":85},
        {"wheelPeripheryReinfBeamDampCutoffHz":250,"wheelPeripheryReinfBeamPrecompression":0.98},

        //general tire values
        {"nodeWeight":0.22},
        {"nodeMaterial":"|NM_RUBBER"},
        {"triangleCollision":false},
        {"pressurePSI":"$tirepressure_R"},
        {"dragCoef":5},

        //groundmodel friction multipliers
        {"frictionCoef":1},
        {"slidingFrictionCoef":1},
        {"stribeckExponent":1.25},
        {"stribeckVelMult":3.5},
        {"treadCoef":0.00},

        //advanced friction values
        {"noLoadCoef":1.82},
        {"loadSensitivitySlope":0.00018},
        {"fullLoadCoef":0.95},
        {"softnessCoef":0.50},

        //deform values
        {"wheelSideBeamDeform":17000,"wheelSideBeamStrength":22000},
        {"wheelTreadBeamDeform":12000,"wheelTreadBeamStrength":16000},
        {"wheelPeripheryBeamDeform":55000,"wheelPeripheryBeamStrength":55000},
    ],
},
