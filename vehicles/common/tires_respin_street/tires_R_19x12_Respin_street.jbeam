"tire_R_345_35_19_Respin_hard_slick": {
    "information":{
        "authors":"BeamNG / ReSpin",
        "name":"345/35R19 Hard Slick (C2) Rear Tires Respin",
        "value":480,
    },
    "slotType" : "tire_R_19x12",
    "flexbodies": [
