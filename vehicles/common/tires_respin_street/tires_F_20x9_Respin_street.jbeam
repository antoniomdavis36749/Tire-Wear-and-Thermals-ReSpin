{
"tire_F_245_30_20_Respin_sport_plus": {
    "information":{
        "authors":"BeamNG / ReSpin",
        "name":"245/30R20 Sport Plus Front Tires Respin",
        "value":390,
    },
    "slotType" : "tire_F_20x9",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["tire_245_30_20_sport", ["tire_FR","wheel_FR"], [], {"pos":{"x":-0.49, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":0},     "scale":{"x":0.98, "y":0.99, "z":0.99}}],
        ["tire_245_30_20_sport", ["tire_FL","wheel_FL"], [], {"pos":{"x": 0.49, "y":0.0, "z":0.0}, "rot":{"x":0, "y":0, "z":180},   "scale":{"x":0.98, "y":0.99, "z":0.99}}],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$tirepressure_F", "range", "psi", "Wheels", 28, 0, 50, "Tire Pressure", "Relative to atmospheric pressure", {"subCategory":"Front"}],
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        {"disableMeshBreaking":false,"disableHubMeshBreaking":false},
        {"hasTire":true},
        {"enableTireReinfBeams":false},
        {"enableTireLbeams":true},
        {"enableTireSideReinfBeams":false},
        {"enableTreadReinfBeams":true},
        {"enableTirePeripheryReinfBeams":true},

        //general settings
        {"radius":0.329},
        {"tireWidth":0.220},

        //tire options
        {"wheelSideBeamSpring":"$=$tirepressure_F*650","wheelSideBeamDamp":25},
        {"wheelSideBeamSpringExpansion":491000,"wheelSideBeamDampExpansion":45},
        {"wheelSideTransitionZone":0.12,"wheelSideBeamPrecompression":0.98},

        //{"wheelSideReinfBeamSpring":"$=$tirepressure_F*833","wheelSideReinfBeamDamp":25},
        //{"wheelSideReinfBeamSpringExpansion":151000,"wheelSideReinfBeamDampExpansion":45},
        //{"wheelSideReinfTransitionZone":0.1,"wheelSideReinfBeamPrecompression":0.98},

        {"wheelReinfBeamSpring":37000,"wheelReinfBeamDamp":200},
        {"wheelReinfBeamDampCutoffHz":250,"wheelReinfBeamPrecompression":0.98},

        {"wheelTreadBeamSpring":141000,"wheelTreadBeamDamp":140},
        {"wheelTreadBeamDampCutoffHz":250,"wheelTreadBeamPrecompression":0.985},

        {"wheelTreadReinfBeamSpring":141000,"wheelTreadReinfBeamDamp":140},
        {"wheelTreadReinfBeamDampCutoffHz":250,"wheelTreadReinfBeamPrecompression":0.965},

        {"wheelPeripheryBeamSpring":81000,"wheelPeripheryBeamDamp":100},
        {"wheelPeripheryBeamDampCutoffHz":250,"wheelPeripheryBeamPrecompression":0.98},

        {"wheelPeripheryReinfBeamSpring":81000,"wheelPeripheryReinfBeamDamp":100},
        {"wheelPeripheryReinfBeamDampCutoffHz":250,"wheelPeripheryReinfBeamPrecompression":0.98},

        //general tire values
        {"nodeWeight":0.18},
        {"nodeMaterial":"|NM_RUBBER"},
        {"triangleCollision":false},
        {"pressurePSI":"$tirepressure_F"},
        {"dragCoef":5},

        //groundmodel friction multipliers
        {"frictionCoef":1.0},
        {"slidingFrictionCoef":1.0},
        {"stribeckExponent":1.25},
        {"stribeckVelMult":2.35},
        {"treadCoef":0.30},

        //advanced friction values
        {"noLoadCoef":1.49},
        {"loadSensitivitySlope":0.000158},
        {"fullLoadCoef":0.65},
        {"softnessCoef":1},

        //deform values
        {"wheelSideBeamDeform":17000,"wheelSideBeamStrength":22000},
        {"wheelTreadBeamDeform":12000,"wheelTreadBeamStrength":16000},
        {"wheelPeripheryBeamDeform":55000,"wheelPeripheryBeamStrength":55000},

    ],
},
